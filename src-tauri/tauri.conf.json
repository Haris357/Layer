{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Layer",
  "version": "1.9.0",
  "identifier": "app.layer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Layer",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/Layer/assets/**",
          "$DATA/Layer/assets/**",
          "$APPDATA/Layer/shelf/**",
          "$DATA/Layer/shelf/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Layer",
    "copyright": "Copyright © 2026 Layer",
    "category": "Productivity",
    "licenseFile": "eula.txt",
    "shortDescription": "A quiet layer on your desktop",
    "longDescription": "Drop widgets onto your desktop. Notes, clocks, links, images, videos. Customize your view, your way.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MEEyQTlFNTg3QUU5QgpSV1Nicm9mbHFhS0FCOWtTdXVrdklPZTdDL0twQjlnc01yT3Y2ajcrUDBGenJMK09KbEJ6VXVucQo=",
      "endpoints": [
        "https://github.com/Haris357/Layer-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
